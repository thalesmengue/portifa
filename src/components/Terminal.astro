---
import { shell } from "../data";
import { getNotes } from "../notes";

const notes = (await getNotes()).map((n) => ({ title: n.data.title, url: `/notes/${n.id}/` }));
const windows = ["help", "projects", "notes", "play", "contact"];
---

<section class="card dark terminal" aria-label="Interactive terminal" data-notes={JSON.stringify(notes)}>
  <header class="titlebar">
    <span class="title">{shell.user}@{shell.host}: ~</span>
    <span class="controls" aria-hidden="true">
      <i class="min"></i><i class="max"></i><i class="close"></i>
    </span>
  </header>

  <div class="screen" id="screen">
    <div id="output" aria-live="polite"></div>
    <form id="prompt" autocomplete="off" class="waiting">
      <label for="cmd" class="ps1"><span class="arrow">➜</span> <span class="dir">~</span></label>
      <input id="cmd" type="text" spellcheck="false" autocapitalize="off" aria-label="command" />
    </form>
  </div>

  <nav class="status" aria-label="Quick commands">
    <span class="windows">
      {windows.map((w, i) => (
        <button type="button" data-run={w}>
          {i}:{w}
        </button>
      ))}
    </span>
    <span class="clock" id="clock"></span>
  </nav>
</section>

<script>
  import { site, shell, stack, projects, contact, now, type Link } from "../data";

  const root = document.querySelector<HTMLElement>(".terminal")!;
  const notes: Link[] = JSON.parse(root.dataset.notes ?? "[]").map((n: { title: string; url: string }) => ({
    name: n.title,
    url: n.url,
  }));

  const screen = document.getElementById("screen")!;
  const output = document.getElementById("output")!;
  const form = document.getElementById("prompt") as HTMLFormElement;
  const input = document.getElementById("cmd") as HTMLInputElement;
  const clock = document.getElementById("clock")!;

  const history: string[] = [];
  let cursor = 0;
  let busy = true;

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const link = ({ name, url }: Link, external = true) =>
    `<a href="${esc(url)}"${external ? ' target="_blank" rel="noopener"' : ""}>${esc(name)}</a>`;
  const dim = (s: string) => `<span class="dim">${s}</span>`;
  const rows = (pairs: string[][], pad = 10) => pairs.map(([k, v]) => `${dim(k.padEnd(pad))}${v}`).join("\n");

  const CAT = [
    "    /\\_____/\\",
    "   /  o   o  \\",
    "  ( ==  ^  == )",
    "   )         (",
    "  (           )",
    " ( (  )   (  ) )",
    "(__(__)___(__)__)",
  ];

  // fastfetch-style card: ascii cat on the left, info on the right
  function fetch() {
    const id = `${shell.user}@${shell.host}`;
    const info = [
      `<span class="key">${esc(shell.user)}</span>@<span class="key">${esc(shell.host)}</span>`,
      dim("-".repeat(id.length)),
      ...[
        ["name", site.name.toLowerCase()],
        ["role", site.role],
        ["stack", stack.main.join(", ")],
        ["also", stack.also.join(", ")],
        ["shell", "zsh"],
        ["locale", "pt-BR"],
      ].map(([k, v]) => `<span class="row"><span class="key">${k}${dim(":")}</span><span>${esc(v)}</span></span>`),
      "",
      Array.from({ length: 8 }, (_, i) => `<i class="swatch c${i}"></i>`).join(""),
    ];
    const art = esc(CAT.join("\n"));
    return { art, info };
  }

  const files: Record<string, () => string> = {
    "about.txt": () => esc(site.about),
    "stack.txt": () => commands.stack(),
    "projects.txt": () => commands.projects(),
    "contact.txt": () => commands.contact(),
  };

  const commands: Record<string, (...args: string[]) => string | null> = {
    help: () =>
      rows(
        [
          ["about", "a few words about me"],
          ["stack", "what i work with"],
          ["projects", "things i made"],
          ["notes", "things i wrote"],
          ["now", "what i'm up to"],
          ["contact", "where to find me"],
          ["play", "start the cat game"],
          ["fastfetch", "system info, kind of"],
          ["ls, cat", "browse files"],
          ["clear", "clear the screen"],
        ],
        11,
      ),
    whoami: () => esc(shell.user),
    about: () => esc(site.about),
    stack: () => rows([["main", esc(stack.main.join(", "))], ["also", esc(stack.also.join(", "))]], 6),
    projects: () => projects.map((p) => `${link(p)}  ${dim(esc(p.desc))}`).join("\n"),
    notes: () => (notes.length ? notes.map((n) => link(n, false)).join("\n") : dim("no notes yet.")),
    now: () =>
      rows([
        ["playing", `${esc(now.playing.title)} ${dim("by")} ${esc(now.playing.artist)}`],
        ...now.setup.map(([k, v]) => [k, esc(v)]),
      ]),
    contact: () => rows(contact.map((c) => [c.name, link({ name: c.url.replace(/^mailto:|^https?:\/\/(www\.)?/, ""), url: c.url })]), 10),
    play: () => {
      document.dispatchEvent(new CustomEvent("cat:play"));
      return dim("game started. press space or tap the game to jump.");
    },
    fastfetch: () => null, // handled in run()
    ls: () => Object.keys(files).join("  "),
    cat: (arg) => {
      if (!arg) return esc([...CAT, "", "      meow."].join("\n"));
      const f = files[arg.replace(/^~\//, "")];
      return f ? f() : `cat: ${esc(arg)}: No such file or directory`;
    },
    pwd: () => `/home/${shell.user}`,
    date: () => new Date().toString(),
    echo: (...args) => esc(args.join(" ")),
    sudo: () => "nice try.",
    exit: () => "there is no escape.",
    clear: () => {
      output.innerHTML = "";
      return null;
    },
  };
  commands.neofetch = commands.fastfetch;

  const promptHtml = (cmd: string) =>
    `<span class="ps1"><span class="arrow">➜</span> <span class="dir">~</span></span> ${esc(cmd)}`;

  function print(html: string, cls = "") {
    const line = document.createElement("div");
    if (cls) line.className = cls;
    line.innerHTML = html;
    output.appendChild(line);
    screen.scrollTop = screen.scrollHeight;
    return line;
  }

  // print line by line, like a program writing to stdout
  async function stream(lines: string[], delay = 28) {
    for (const l of lines) {
      print(l || " ");
      await sleep(delay);
    }
  }

  async function printFetch() {
    const { art, info } = fetch();
    const block = print(`<pre class="art">${art}</pre><div class="info"></div>`, "fetch");
    const box = block.querySelector(".info")!;
    for (const l of info) {
      const row = document.createElement("div");
      row.innerHTML = l || " ";
      box.appendChild(row);
      screen.scrollTop = screen.scrollHeight;
      await sleep(45);
    }
  }

  function setBusy(v: boolean) {
    busy = v;
    form.classList.toggle("waiting", v);
  }

  async function run(raw: string) {
    const line = raw.trim();
    print(promptHtml(line));
    if (!line) return;

    history.push(line);
    cursor = history.length;

    const [name, ...args] = line.split(/\s+/);
    if (name === "fastfetch" || name === "neofetch") {
      setBusy(true);
      await printFetch();
      setBusy(false);
      return;
    }

    const cmd = commands[name];
    const result = cmd ? cmd(...args) : `zsh: command not found: ${esc(name)}`;
    if (result) {
      setBusy(true);
      await stream(result.split("\n"), 18);
      setBusy(false);
    }
  }

  async function type(text: string) {
    const line = print(`${promptHtml("")}<span class="typed"></span><span class="caret"></span>`);
    const typed = line.querySelector(".typed")!;
    await sleep(500);
    for (const ch of text) {
      typed.textContent += ch;
      await sleep(60 + Math.random() * 60);
    }
    await sleep(300);
    line.querySelector(".caret")?.remove();
  }

  async function intro() {
    await document.fonts?.ready;
    await type("fastfetch");
    await printFetch();
    await sleep(120);
    setBusy(false);
  }

  async function exec(cmd: string) {
    if (busy) return;
    input.value = "";
    await run(cmd);
    screen.scrollTop = screen.scrollHeight;
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    exec(input.value);
  });

  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowUp" && cursor > 0) {
      input.value = history[--cursor];
      e.preventDefault();
    } else if (e.key === "ArrowDown") {
      cursor = Math.min(cursor + 1, history.length);
      input.value = history[cursor] ?? "";
      e.preventDefault();
    } else if (e.key === "Tab") {
      e.preventDefault();
      const [name, arg] = input.value.split(/\s+/);
      if (arg !== undefined) {
        const match = Object.keys(files).find((f) => f.startsWith(arg));
        if (match) input.value = `${name} ${match}`;
      } else {
        const match = Object.keys(commands).find((c) => c.startsWith(name));
        if (match) input.value = match;
      }
    } else if (e.key === "l" && e.ctrlKey) {
      e.preventDefault();
      commands.clear();
    }
  });

  screen.addEventListener("click", () => {
    if (!busy && !window.getSelection()?.toString()) input.focus({ preventScroll: true });
  });

  root.querySelectorAll<HTMLButtonElement>("[data-run]").forEach((b) =>
    b.addEventListener("click", () => exec(b.dataset.run!)),
  );

  const tickClock = () => {
    clock.textContent = new Date().toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
  };
  tickClock();
  setInterval(tickClock, 15_000);

  intro();
</script>

<style>
  .terminal {
    --t-green: #8ae234;
    --t-cyan: #5fd7d7;
    display: flex;
    flex-direction: column;
    min-height: 0;
    font-size: 12px;
    line-height: 1.65;
    font-variant-ligatures: none;
  }

  .screen {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 16px 18px 12px;
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--on-dark-line) transparent;
  }

  #prompt {
    display: flex;
    gap: 8px;
  }

  /* keep the prompt's space reserved while a command runs, so nothing jumps */
  #prompt.waiting {
    opacity: 0;
  }

  #cmd {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    color: inherit;
    font: inherit;
    caret-color: var(--on-dark);
    padding: 0;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    height: 30px;
    padding: 0 10px;
    background: var(--term-bar);
    font-size: 12px;
    color: var(--on-dark-muted);
    white-space: nowrap;
  }

  .windows {
    flex: 1;
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .windows button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 2px 6px;
    border-radius: 2px;
    cursor: pointer;
  }

  .windows button:hover,
  .windows button:focus-visible {
    color: var(--dark);
    background: var(--t-green);
    outline: none;
  }

  .clock {
    color: var(--on-dark);
  }

  /* output lines are injected at runtime, so they are outside the scoped styles */
  .terminal :global(#output > div) {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal :global(.ps1) {
    white-space: nowrap;
    font-weight: 700;
  }

  .terminal :global(.arrow) {
    color: var(--t-green);
  }

  .terminal :global(.dir) {
    color: var(--t-cyan);
  }

  .terminal :global(.dim) {
    color: var(--on-dark-muted);
  }

  .terminal :global(.key) {
    color: var(--t-green);
    font-weight: 700;
  }

  .terminal :global(#output a) {
    color: var(--on-dark);
    text-decoration-color: var(--on-dark-muted);
    text-underline-offset: 3px;
  }

  .terminal :global(.fetch) {
    display: flex;
    gap: 3ch;
    margin: 10px 0 14px;
  }

  .terminal :global(.art) {
    margin: 0;
    font: inherit;
    color: var(--t-green);
    font-weight: 700;
    padding-top: 2px;
  }

  .terminal :global(.info) {
    min-width: 0;
  }

  .terminal :global(.row) {
    display: flex;
    gap: 1ch;
  }

  .terminal :global(.row .key) {
    flex: none;
  }

  .terminal :global(.swatch) {
    display: inline-block;
    width: 18px;
    height: 12px;
  }

  .terminal :global(.c0) { background: #2e3436; }
  .terminal :global(.c1) { background: #ef2929; }
  .terminal :global(.c2) { background: #8ae234; }
  .terminal :global(.c3) { background: #fce94f; }
  .terminal :global(.c4) { background: #729fcf; }
  .terminal :global(.c5) { background: #ad7fa8; }
  .terminal :global(.c6) { background: #34e2e2; }
  .terminal :global(.c7) { background: #eeeeec; }

  .terminal :global(.caret) {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--on-dark);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .terminal :global(.art) {
      display: none;
    }
  }
</style>
