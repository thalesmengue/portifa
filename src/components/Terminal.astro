---
import { shell } from "../data";

const ps1 = `${shell.user}@${shell.host}:~$`;
---

<section class="terminal" aria-label="Terminal interativo">
  <div class="bar">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <span class="title">{shell.user}@{shell.host}: ~</span>
  </div>
  <div class="screen" id="screen">
    <div id="output" aria-live="polite"></div>
    <form id="prompt" autocomplete="off">
      <label for="cmd" class="ps1">{ps1}</label>
      <input id="cmd" type="text" spellcheck="false" autocapitalize="off" aria-label="comando" />
    </form>
  </div>
</section>

<script>
  import { site, shell, stack, projects, contact, type Link } from "../data";

  const data = { ...site, stack, projects, contact };
  const ps1 = `${shell.user}@${shell.host}:~$`;

  const screen = document.getElementById("screen")!;
  const output = document.getElementById("output")!;
  const form = document.getElementById("prompt") as HTMLFormElement;
  const input = document.getElementById("cmd") as HTMLInputElement;

  const history: string[] = [];
  let cursor = 0;

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const link = ({ name, url }: Link) => `<a href="${esc(url)}" target="_blank" rel="noopener">${esc(name)}</a>`;

  const CAT = [" /\\_/\\", "( o.o )", " > ^ <   meow."].join("\n");

  const files: Record<string, () => string> = {
    "about.txt": () => esc(data.about),
    "stack.txt": () => commands.stack(),
    "projects.txt": () => commands.projects(),
    "contact.txt": () => commands.contact(),
  };

  const commands: Record<string, (...args: string[]) => string | null> = {
    help: () =>
      [
        ["whoami", "who am i"],
        ["about", "a few words"],
        ["stack", "what i work with"],
        ["projects", "things i made"],
        ["contact", "where to find me"],
        ["ls", "list files"],
        ["cat <file>", "read a file"],
        ["clear", "clear the screen"],
      ]
        .map(([c, d]) => `${c.padEnd(12)}<span class="dim">${d}</span>`)
        .join("\n"),
    whoami: () => esc(data.whoami),
    about: () => esc(data.about),
    stack: () =>
      [
        `${"main".padEnd(6)}${esc(data.stack.main.join(", "))}`,
        `<span class="dim">${"also".padEnd(6)}${esc(data.stack.also.join(", "))}</span>`,
      ].join("\n"),
    projects: () => data.projects.map((p) => `${link(p)}  <span class="dim">${esc(p.desc)}</span>`).join("\n"),
    contact: () => data.contact.map(link).join("\n"),
    ls: () => Object.keys(files).join("  "),
    cat: (arg) => {
      if (!arg) return esc(CAT);
      const f = files[arg];
      return f ? f() : `cat: ${esc(arg)}: No such file or directory`;
    },
    pwd: () => `/home/${shell.user}`,
    date: () => new Date().toString(),
    echo: (...args) => esc(args.join(" ")),
    sudo: () => "nice try.",
    clear: () => {
      output.innerHTML = "";
      return null;
    },
  };

  function print(html: string) {
    const line = document.createElement("div");
    line.innerHTML = html;
    output.appendChild(line);
  }

  function run(raw: string) {
    const line = raw.trim();
    print(`<span class="ps1">${ps1}</span> ${esc(line)}`);
    if (!line) return;

    history.push(line);
    cursor = history.length;

    const [name, ...args] = line.split(/\s+/);
    const cmd = commands[name];
    const result = cmd ? cmd(...args) : `${esc(name)}: command not found. try <span class="dim">help</span>`;
    if (result) print(result);
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    run(input.value);
    input.value = "";
    screen.scrollTop = screen.scrollHeight;
  });

  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowUp" && cursor > 0) {
      input.value = history[--cursor];
      e.preventDefault();
    } else if (e.key === "ArrowDown") {
      cursor = Math.min(cursor + 1, history.length);
      input.value = history[cursor] ?? "";
      e.preventDefault();
    } else if (e.key === "Tab") {
      e.preventDefault();
      const [name, arg] = input.value.split(/\s+/);
      if (arg !== undefined) {
        const match = Object.keys(files).find((f) => f.startsWith(arg));
        if (match) input.value = `${name} ${match}`;
      } else {
        const match = Object.keys(commands).find((c) => c.startsWith(name));
        if (match) input.value = match;
      }
    } else if (e.key === "l" && e.ctrlKey) {
      e.preventDefault();
      commands.clear();
    }
  });

  screen.addEventListener("click", () => {
    if (!window.getSelection()?.toString()) input.focus();
  });

  print(`<span class="dim">welcome. type</span> help <span class="dim">to see available commands.</span>`);
</script>

<style>
  .terminal {
    background: var(--term-bg);
    color: var(--term-fg);
    border-radius: 8px;
    overflow: hidden;
    font-size: 13px;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid #ffffff10;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #44403c;
  }

  .title {
    flex: 1;
    text-align: center;
    color: var(--term-muted);
    font-size: 12px;
    margin-right: 48px;
  }

  .screen {
    height: 260px;
    overflow-y: auto;
    padding: 12px 14px;
    cursor: text;
  }

  #prompt {
    display: flex;
    gap: 8px;
  }

  #cmd {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    color: inherit;
    font: inherit;
    caret-color: var(--accent);
    padding: 0;
  }

  /* output lines are injected at runtime, so they are outside the scoped styles */
  .terminal :global(#output > div) {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal :global(.ps1) {
    color: var(--accent);
    white-space: nowrap;
  }

  .terminal :global(.dim) {
    color: var(--term-muted);
  }

  .terminal :global(a) {
    color: var(--term-fg);
  }
</style>
