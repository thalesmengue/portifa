---
import { shell } from "../data";
import { getNotes } from "../notes";

const notes = (await getNotes()).map((n) => ({
  title: n.data.title,
  url: `/notes/${n.id}/`,
  slug: n.id,
  description: n.data.description,
}));
const windows = ["help", "projects", "notes", "play", "contact"];
---

<section class="card dark terminal" aria-label="Interactive terminal" data-notes={JSON.stringify(notes)}>
  <header class="titlebar">
    <span class="title">{shell.user}@{shell.host}: ~</span>
    <span class="controls" aria-hidden="true">
      <i class="min"></i><i class="max"></i><i class="close"></i>
    </span>
  </header>

  <div class="screen">
    <div class="output" aria-live="polite"></div>
    <form class="prompt waiting" autocomplete="off">
      <label for="cmd" class="ps1-label"></label>
      <input id="cmd" class="cmd" type="text" spellcheck="false" autocapitalize="off" aria-label="command" />
      <span class="hint"></span>
    </form>
  </div>

  <nav class="status" aria-label="Quick commands">
    <span class="windows">
      {windows.map((w, i) => (
        <button type="button" data-run={w}>
          {i}:{w}
        </button>
      ))}
    </span>
    <span class="clock"></span>
  </nav>
</section>

<script>
  import { mountShell } from "../terminal/shell";

  mountShell(document.querySelector<HTMLElement>(".terminal")!);
</script>

<style>
  .terminal {
    --t-green: #8ae234;
    --t-cyan: #5fd7d7;
    display: flex;
    flex-direction: column;
    min-height: 0;
    font-size: 12px;
    line-height: 1.65;
    font-variant-ligatures: none;
    transition: background 0.2s;
  }

  .screen {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 16px 18px 12px;
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--on-dark-line) transparent;
  }

  .prompt {
    display: flex;
    gap: 1ch;
  }

  /* keep the prompt's space reserved while a command runs, so nothing jumps */
  .prompt.waiting {
    opacity: 0;
  }

  .ps1-label {
    white-space: pre;
  }

  .cmd {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    color: inherit;
    font: inherit;
    caret-color: var(--on-dark);
    padding: 0;
  }

  .hint {
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* reverse-i-search: label, query and match sit on one line */
  .searching .prompt {
    gap: 0;
  }

  .searching .cmd {
    flex: none;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    height: 30px;
    padding: 0 10px;
    background: var(--term-bar);
    font-size: 12px;
    color: var(--on-dark-muted);
    white-space: nowrap;
  }

  .windows {
    flex: 1;
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .windows button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 2px 6px;
    border-radius: 2px;
    cursor: pointer;
  }

  .windows button:hover,
  .windows button:focus-visible {
    color: var(--dark);
    background: var(--t-green);
    outline: none;
  }

  .clock {
    color: var(--on-dark);
  }

  /* output lines are injected at runtime, so they are outside the scoped styles */
  .terminal :global(.output > div) {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal :global(.ps1) {
    white-space: pre;
    font-weight: 700;
  }

  .terminal :global(.arrow),
  .terminal :global(.key),
  .terminal :global(.ls-exec) {
    color: var(--t-green);
  }

  .terminal :global(.key),
  .terminal :global(.ls-dir),
  .terminal :global(.ls-exec) {
    font-weight: 700;
  }

  .terminal :global(.dir),
  .terminal :global(.t-cyan) {
    color: var(--t-cyan);
  }

  .terminal :global(.ls-dir) {
    color: #729fcf;
  }

  .terminal :global(.dim) {
    color: var(--on-dark-muted);
  }

  .terminal :global(.yellow) {
    color: #e5c07b;
  }

  .terminal :global(.match) {
    color: #ef2929;
    font-weight: 700;
  }

  .terminal :global(.badge) {
    font-weight: 700;
    color: #fff;
    border-radius: 1px;
  }

  .terminal :global(.badge.info) { background: #3b82f6; }
  .terminal :global(.badge.warn) { background: #d97706; }
  .terminal :global(.badge.error) { background: #dc2626; }

  .terminal :global(.output a) {
    color: var(--on-dark);
    text-decoration-color: var(--on-dark-muted);
    text-underline-offset: 3px;
  }

  .terminal :global(.fetch) {
    display: flex;
    gap: 3ch;
    margin: 10px 0 14px;
  }

  .terminal :global(.art) {
    margin: 0;
    font: inherit;
    color: var(--t-green);
    font-weight: 700;
    padding-top: 2px;
  }

  .terminal :global(.info) {
    min-width: 0;
  }

  .terminal :global(.row) {
    display: flex;
    gap: 1ch;
  }

  .terminal :global(.row .key) {
    flex: none;
  }

  .terminal :global(.swatch) {
    display: inline-block;
    width: 18px;
    height: 12px;
  }

  .terminal :global(.c0) { background: #2e3436; }
  .terminal :global(.c1) { background: #ef2929; }
  .terminal :global(.c2) { background: #8ae234; }
  .terminal :global(.c3) { background: #fce94f; }
  .terminal :global(.c4) { background: #729fcf; }
  .terminal :global(.c5) { background: #ad7fa8; }
  .terminal :global(.c6) { background: #34e2e2; }
  .terminal :global(.c7) { background: #eeeeec; }

  /* vim */
  .terminal :global(.vim-tilde) {
    color: #729fcf;
  }

  .terminal :global(.vim-status) {
    margin-top: 4px;
    min-height: 1.65em;
  }

  .terminal :global(.vim-err) {
    color: #fff;
    background: #dc2626;
  }

  .terminal :global(.caret) {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--on-dark);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .terminal :global(.art) {
      display: none;
    }
  }
</style>
