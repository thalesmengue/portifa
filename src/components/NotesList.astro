---
import { getNotes, badge } from "../notes";

const notes = await getNotes();
---

<div class="notes">
  <p class="eyebrow">latest notes</p>
  <h2 class="sans">Things I learned shipping Laravel and keeping servers alive.</h2>

  {
    notes.length === 0 ? (
      <p class="empty">nothing here yet. soon.</p>
    ) : (
      <ol>
        {notes.map((note, i) => {
          const b = badge(note);
          return (
            <li>
              <a href={`/notes/${note.id}/`}>
                <span class="n">{String(notes.length - i).padStart(2, "0")}</span>
                <span class="title sans">
                  {note.data.title}
                  {b && <span class="badge">{b}</span>}
                </span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })}
      </ol>
    )
  }
</div>

<style>
  .notes {
    min-width: 0;
  }

  h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 6px 0 18px;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 245px;
    overflow-y: auto;
    border-top: 1px solid var(--border);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  li {
    border-bottom: 1px solid var(--border);
  }

  a {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 12px 14px;
    text-decoration: none;
    transition: background 0.15s;
  }

  a:hover {
    background: color-mix(in srgb, var(--border) 35%, transparent);
  }

  .n {
    font-size: 12px;
    color: var(--muted);
  }

  .title {
    flex: 1;
    font-size: 16px;
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .badge {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent) 30%, var(--frame));
    padding: 1px 7px;
    border-radius: 2px;
  }

  .arrow {
    font-size: 12px;
    color: var(--muted);
    transition: transform 0.15s;
  }

  a:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--fg);
  }

  .empty {
    color: var(--muted);
  }
</style>
