---
import { now } from "../data";
---

<aside class="now">
  <div class="player">
    <div class="art" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <div class="track">
      <p class="eyebrow">now playing</p>
      <p class="song sans">{now.playing.title}</p>
      <p class="artist">{now.playing.artist}</p>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><span></span></div>

  <p class="fn">setup.list()</p>
  <dl>
    {now.setup.map(([k, v]) => (
      <div>
        <dt>{k}</dt>
        <dd>{v}</dd>
      </div>
    ))}
  </dl>
</aside>

<style>
  .now {
    border-left: 1px solid var(--border);
    padding-left: 24px;
    display: flex;
    flex-direction: column;
  }

  .player {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .art {
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 4px;
    background: var(--dark);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    padding-bottom: 16px;
  }

  .art span {
    width: 6px;
    height: 12px;
    background: var(--accent);
    animation: eq 1.1s ease-in-out infinite alternate;
  }

  .art span:nth-child(2) { animation-delay: -0.4s; }
  .art span:nth-child(3) { animation-delay: -0.8s; }
  .art span:nth-child(4) { animation-delay: -0.2s; }

  @keyframes eq {
    from { height: 6px; }
    to { height: 36px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .art span, .progress span { animation: none; }
  }

  .track {
    min-width: 0;
  }

  .track p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song {
    font-weight: 600;
    font-size: 15px;
  }

  .artist {
    font-size: 12px;
    color: var(--muted);
  }

  .progress {
    height: 2px;
    background: var(--border);
    margin: 16px 0 20px;
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--fg);
    transform-origin: left;
    animation: progress 180s linear infinite;
  }

  @keyframes progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .fn {
    margin: 0 0 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  dl {
    margin: 0;
    font-size: 13px;
  }

  dl div {
    display: flex;
    gap: 12px;
    padding: 3px 0;
  }

  dt {
    width: 72px;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  @media (max-width: 860px) {
    .now {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--border);
      padding-top: 20px;
    }
  }
</style>
