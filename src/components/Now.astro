---
import { now } from "../data";
import { configured, nowPlaying } from "../spotify";
import type { Track } from "../track";
import spotifyLogo from "../assets/spotify-logo.svg?raw";

// first paint comes from the server (cached for 20s); the script below keeps it fresh.
// Spotify being slow or down never holds the page: give up after a moment and show the fallback.
const track: Track | null = configured()
  ? await Promise.race([nowPlaying().catch(() => null), new Promise<null>((r) => setTimeout(r, 800, null))])
  : null;
const playing = track?.playing ?? false;
---

<aside class="now">
  <div class={`player${track && !playing ? " idle" : ""}`}>
    <div class="art" aria-hidden="true">
      {track?.art && <img src={track.art} alt="" width="72" height="72" />}
    </div>
    <div class="track">
      <p class="eyebrow">
        <span class="eq" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="state">{track && !playing ? "last played" : "now playing"}</span>
      </p>
      <p class="song sans" title={track?.title}>
        {track ? <a href={track.url} target="_blank" rel="noopener">{track.title}</a> : <a>{now.playing.title}</a>}
      </p>
      <p class="artist" title={track?.artist}>{track?.artist ?? now.playing.artist}</p>
    </div>
  </div>
  <div class={`progress${track ? " live" : ""}`} aria-hidden="true"><span></span></div>
  <!-- Spotify asks for its full logo next to anything it supplies -->
  <a class="spotify" href={track?.url} target="_blank" rel="noopener" aria-label="Listen on Spotify" hidden={!track}>
    <Fragment set:html={spotifyLogo} />
  </a>

  <p class="fn">setup.list()</p>
  <dl>
    {now.setup.map(([k, v]) => (
      <div>
        <dt>{k}</dt>
        <dd>{v}</dd>
      </div>
    ))}
  </dl>
</aside>

<script>
  import { nowPlaying, type Track } from "../scripts/now-playing";

  const POLL = 30_000;
  const player = document.querySelector<HTMLElement>(".now .player")!;
  const art = player.querySelector<HTMLElement>(".art")!;
  const eyebrow = player.querySelector<HTMLElement>(".eyebrow .state")!;
  const song = player.querySelector<HTMLAnchorElement>(".song a")!;
  const artist = player.querySelector<HTMLElement>(".artist")!;
  const bar = document.querySelector<HTMLElement>(".now .progress")!;
  const fill = bar.querySelector<HTMLElement>("span")!;
  const spotify = document.querySelector<HTMLAnchorElement>(".now .spotify")!;

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // the bar is a CSS animation: duration = track length, negative delay = how far in we are
  function progress(playing: boolean, at: number, duration: number) {
    bar.classList.add("live");
    fill.style.animation = "none";
    fill.style.transform = playing && duration ? `scaleX(${Math.min(at / duration, 1)})` : "";
    if (!playing || !duration || reduced) return;
    void fill.offsetWidth; // restart it
    fill.style.animation = `progress ${duration}ms linear ${-at}ms 1 forwards`;
  }

  function render(t: Track) {
    player.classList.toggle("idle", !t.playing);
    eyebrow.textContent = t.playing ? "now playing" : "last played";
    song.textContent = t.title;
    song.href = t.url;
    song.target = "_blank";
    song.rel = "noopener";
    song.parentElement!.title = t.title;
    artist.textContent = t.artist;
    artist.title = t.artist;
    spotify.href = t.url;
    spotify.hidden = false;

    let img = art.querySelector("img");
    if (t.art) {
      img ??= art.insertAdjacentElement("afterbegin", Object.assign(new Image(72, 72), { alt: "" })) as HTMLImageElement;
      if (img.src !== t.art) img.src = t.art;
    } else img?.remove();

    progress(t.playing, t.progress, t.duration);
  }

  async function refresh() {
    if (document.hidden) return;
    const t = await nowPlaying();
    if (t) render(t);
  }

  refresh(); // syncs the progress bar right away
  setInterval(refresh, POLL);
  document.addEventListener("visibilitychange", refresh);
</script>

<style>
  .now {
    border-left: 1px solid var(--border);
    padding-left: 24px;
    display: flex;
    flex-direction: column;
  }

  .player {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .art {
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 4px;
    background: var(--dark);
    position: relative;
    overflow: hidden;
  }

  .art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain; /* never crop the cover */
  }

  /* the equalizer lives next to the label: Spotify doesn't allow anything on top of cover art */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .eq span {
    width: 2px;
    height: 4px;
    background: var(--accent);
    animation: eq 1.1s ease-in-out infinite alternate;
  }

  .eq span:nth-child(2) { animation-delay: -0.4s; }
  .eq span:nth-child(3) { animation-delay: -0.8s; }

  @keyframes eq {
    from { height: 3px; }
    to { height: 10px; }
  }

  /* last played: the equalizer goes quiet */
  .idle .eq {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .eq span, .progress span { animation: none; }
  }

  .track {
    min-width: 0;
  }

  .track p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song {
    font-weight: 600;
    font-size: 15px;
  }

  .song a {
    color: inherit;
    text-decoration: none;
  }

  .song a[href]:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .artist {
    font-size: 12px;
    color: var(--muted);
  }

  .progress {
    height: 2px;
    background: var(--border);
    margin: 16px 0 12px;
    overflow: hidden;
  }

  .spotify {
    display: block;
    width: 74px; /* Spotify's minimum for the full logo is 70px */
    margin-bottom: 12px;
    color: #000;
    line-height: 0;
  }

  .spotify[hidden] {
    display: none;
  }

  .spotify :global(svg) {
    width: 100%;
    height: auto;
  }

  /* logo only in black, white or Spotify green */
  @media (prefers-color-scheme: dark) {
    .spotify {
      color: #fff;
    }
  }

  .progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--fg);
    transform-origin: left;
    animation: progress 180s linear infinite;
  }

  .progress.live span {
    animation: none;
    transform: scaleX(0);
  }

  @keyframes progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .fn {
    margin: 0 0 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  dl {
    margin: 0;
    font-size: 13px;
  }

  dl div {
    display: flex;
    gap: 12px;
    padding: 3px 0;
  }

  dt {
    width: 72px;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  @media (max-width: 860px) {
    .now {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--border);
      padding-top: 20px;
    }
  }
</style>
