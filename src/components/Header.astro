---
// Top bar, the tmux status line promoted to a nav. On the home page each item runs its
// command in the terminal; anywhere else it links home and runs it there (/?run=help).
import { NAV } from "../data";
---

<header>
  <a class="brand" href="/" aria-label="home">thaleslab<span class="caret" aria-hidden="true"></span></a>
  <nav aria-label="Main">
    {NAV.map((name, i) => (
      <a href={`/?run=${name}`} data-run={name} aria-keyshortcuts={String(i)}>
        <span class="idx" aria-hidden="true">{i}</span>{name}
      </a>
    ))}
  </nav>
  <span class="clock" title="my time, são paulo"></span>
</header>

<script>
  const clock = document.querySelector<HTMLElement>("header .clock")!;
  const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "America/Sao_Paulo" });
  const tick = () => (clock.textContent = `${fmt.format(new Date())} brt`);
  tick();
  setInterval(tick, 15_000);
</script>

<style>
  header {
    view-transition-name: site-header;
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 14px;
    padding: 2px 8px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
  }

  .brand {
    color: var(--fg);
    font-weight: 700;
    text-decoration: none;
  }

  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }

  nav {
    flex: 1;
    display: flex;
    gap: 4px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  nav a {
    padding: 2px 6px;
    border-radius: 3px;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }

  .idx {
    margin-right: 0.6ch;
    opacity: 0.55;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--fg);
    background: var(--border);
    outline: none;
  }

  nav a:hover .idx,
  nav a:focus-visible .idx {
    opacity: 1;
  }

  .clock {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    header {
      gap: 10px;
    }

    nav {
      gap: 0;
    }

    nav a {
      padding: 2px 5px;
    }

    .idx,
    .clock {
      display: none;
    }
  }

  /* small phones: everything still fits on one line */
  @media (max-width: 400px) {
    header {
      gap: 6px;
    }

    nav a {
      padding: 2px 3px;
    }
  }
</style>
