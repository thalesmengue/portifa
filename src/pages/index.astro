---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.astro";
import { site, stack, contact } from "../data";
---

<Base>
  <main>
    <header>
      <h1>{site.name}</h1>
      <p class="muted">{site.role} · {stack.main.join(" / ")}</p>
    </header>

    <nav class="links">
      {contact.map((c) => (
        <a href={c.url} target={c.url.startsWith("http") ? "_blank" : undefined} rel="noopener">
          {c.name}
        </a>
      ))}
    </nav>

    <Terminal />
  </main>
</Base>

<style>
  h1 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .muted {
    color: var(--muted);
    margin: 0;
  }

  .links {
    display: flex;
    gap: 20px;
    margin: 24px 0 40px;
  }

  .links a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.15s;
  }

  .links a:hover {
    border-color: var(--fg);
  }
</style>
