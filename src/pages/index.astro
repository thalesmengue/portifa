---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.astro";
import CatGame from "../components/CatGame.astro";
import NotesList from "../components/NotesList.astro";
import Now from "../components/Now.astro";
---

<Base>
  <h1 class="visually-hidden">Thales Machado — software engineer</h1>

  <div class="top">
    <Terminal />
    <CatGame />
  </div>

  <section class="card light bottom">
    <NotesList />
    <Now />
  </section>
</Base>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 10px;
    height: 420px;
  }

  .bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px;
    margin-top: 10px;
    padding: 24px 20px 20px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 440px 300px;
      height: auto;
    }

    .bottom {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
