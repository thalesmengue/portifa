---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import LuaWalker from "../components/LuaWalker.astro";
import { site } from "../data";
import monoFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import sansFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = `${site.name} — ${site.role}.` } = Astro.props;

// privacy-friendly analytics, enabled by setting these at build time (Coolify build variables)
const umami = { src: import.meta.env.PUBLIC_UMAMI_SRC, id: import.meta.env.PUBLIC_UMAMI_ID };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {umami.src && umami.id && <script is:inline defer src={umami.src} data-website-id={umami.id} />}
  </head>
  <body>
    <div class="frame">
      <slot />
      <Footer />
    </div>
    <LuaWalker />
    <script>
      import "../scripts/konami";
    </script>
  </body>
</html>
